# ---------------------------------------------------------------------------
# Example settings for the game server.
#
# Copy this file to `.env` and change the values for your machine.
# `.env` is listed in .gitignore, so your real file is never committed.
# There are no passwords or API keys in this project — only names and numbers.
#
# On a hosting service you set these in the dashboard instead of using a file.
# ---------------------------------------------------------------------------

# The port the server listens on. Hosting providers set this for you, so leave
# it unset in production and it falls back to 3000.
PORT=3000

# Which addresses may open a socket to the server.
# Leave it empty for the normal setup (the site is served by this same server,
# so same-origin connections are allowed). Only set it if you host the website
# somewhere else, for example a CDN:
#   CLIENT_ORIGIN=https://your-site.pages.dev
# Several addresses can be listed, separated by commas.
CLIENT_ORIGIN=

# Safety limit: how many rooms this server holds at once. Each room is a small
# object in memory, and rooms are deleted when they finish or go quiet.
MAX_ROOMS=50
